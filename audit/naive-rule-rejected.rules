rules_version = '2';
/* The OBVIOUS rule, kept only to demonstrate why it was rejected. NOT a proposal. */
service cloud.firestore {
  match /databases/{database}/documents {
    match /notebooks/{nbId} {
      allow read, write: if request.auth != null && request.auth.uid == nbId;
      match /chunks/{chunkId} {
        allow read, write: if request.auth != null && request.auth.uid == nbId;
      }
    }
  }
}
