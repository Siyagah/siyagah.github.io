rules_version = '2';
/* The rule LIVE in the Firebase project today, reproduced verbatim from the
   task brief so the test suite can demonstrate what it actually permits.
   This file is evidence, not a proposal. Never deploy it. */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
